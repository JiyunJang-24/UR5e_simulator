  </equality>

  <actuator>
    <!-- position servo on the arm angle; forcerange chosen so pad force is ~40 N (RG2 max) mid-stroke -->
    <position name="fingers" joint="right_arm_joint" kp="20" kv="0.5" ctrlrange="0 1.5013"
              forcerange="-4.400 4.400"/>
  </actuator>
