<mujoco model="ur5e_rg2_wristcam_tabletop">
  <!-- UR5e + wrist camera mount (RealSense D405) + OnRobot Quick Changer + RG2 on a table.
       The table top is the z = 0 plane, so robot-frame coordinates are unchanged.
       No keyframe here: MuJoCo 3.3 rejects keyframes in models built with <attach>.
       Home pose: data.qpos[:6] = data.ctrl[:6] = [-1.5708, -1.5708, 1.5708, -1.5708, -1.5708, 0] -->
  <include file="ur5e_rg2_wristcam.xml"/>

  <statistic center="0 0.45 0.2" extent="1.0"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="800"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture name="wood" type="2d" builtin="flat" rgb1="0.62 0.47 0.32" rgb2="0.55 0.40 0.27" mark="random"
      random="0.08" markrgb="0.5 0.36 0.24" width="512" height="512"/>
    <material name="table_top" texture="wood" texrepeat="3 3" specular="0.2" shininess="0.1"/>
    <material name="table_leg" rgba="0.25 0.25 0.27 1"/>
    <material name="obj_red" rgba="0.85 0.15 0.12 1"/>
    <material name="obj_green" rgba="0.15 0.65 0.25 1"/>
    <material name="obj_blue" rgba="0.15 0.35 0.85 1"/>
    <material name="obj_yellow" rgba="0.95 0.8 0.1 1"/>
    <material name="obj_white" rgba="0.92 0.92 0.9 1"/>
    <material name="obj_orange" rgba="0.95 0.5 0.1 1"/>
  </asset>

  <default>
    <default class="object">
      <geom friction="1.0 0.005 0.0001" solref="0.004 1" condim="4"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0.4 1.5" dir="0 0 -1" directional="true" castshadow="true"/>
    <light pos="0.6 -0.4 1.2" dir="-0.5 0.5 -1" diffuse="0.3 0.3 0.3" castshadow="false"/>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- table: 0.9 x 1.4 m, top surface at z = 0 -->
    <body name="table" pos="0 0.35 0">
      <geom name="table_top" type="box" size="0.45 0.7 0.02" pos="0 0 -0.02" material="table_top"/>
      <geom type="box" size="0.025 0.025 0.365" pos=" 0.4  0.65 -0.405" material="table_leg"/>
      <geom type="box" size="0.025 0.025 0.365" pos="-0.4  0.65 -0.405" material="table_leg"/>
      <geom type="box" size="0.025 0.025 0.365" pos=" 0.4 -0.65 -0.405" material="table_leg"/>
      <geom type="box" size="0.025 0.025 0.365" pos="-0.4 -0.65 -0.405" material="table_leg"/>
    </body>

    <!-- objects in front of the robot (gripper is above ~(-0.13, 0.49) in the home pose) -->
    <body name="red_cube" pos="-0.13 0.50 0.02">
      <freejoint/>
      <geom class="object" type="box" size="0.02 0.02 0.02" mass="0.05" material="obj_red"/>
    </body>
    <body name="green_cube" pos="-0.02 0.56 0.025" euler="0 0 0.5">
      <freejoint/>
      <geom class="object" type="box" size="0.025 0.025 0.025" mass="0.08" material="obj_green"/>
    </body>
    <body name="blue_can" pos="-0.25 0.58 0.05">
      <freejoint/>
      <geom class="object" type="cylinder" size="0.03 0.05" mass="0.15" material="obj_blue"/>
    </body>
    <body name="yellow_ball" pos="-0.05 0.40 0.025">
      <freejoint/>
      <geom class="object" type="sphere" size="0.025" mass="0.04" material="obj_yellow"/>
    </body>
    <body name="orange_bar" pos="-0.24 0.42 0.015" euler="0 0 -0.6">
      <freejoint/>
      <geom class="object" type="box" size="0.06 0.015 0.015" mass="0.05" material="obj_orange"/>
    </body>
    <!-- open tray -->
    <body name="tray" pos="0.12 0.48 0">
      <geom type="box" size="0.08 0.11 0.004" pos="0 0 0.004" material="obj_white"/>
      <geom type="box" size="0.08 0.004 0.02" pos="0 0.106 0.02" material="obj_white"/>
      <geom type="box" size="0.08 0.004 0.02" pos="0 -0.106 0.02" material="obj_white"/>
      <geom type="box" size="0.004 0.11 0.02" pos="0.076 0 0.02" material="obj_white"/>
      <geom type="box" size="0.004 0.11 0.02" pos="-0.076 0 0.02" material="obj_white"/>
    </body>

    <camera name="overview" pos="0.75 -0.35 0.75" xyaxes="0.55 0.83 0 -0.45 0.3 0.84" fovy="50"/>
  </worldbody>

</mujoco>
